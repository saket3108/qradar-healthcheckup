# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
#   sed -i.bak "s|^QHC_SECRET_KEY=.*|QHC_SECRET_KEY=$(openssl rand -hex 32)|" .env

POSTGRES_PASSWORD=change-me-strong-password
QHC_SECRET_KEY=generate-with-openssl-rand-hex-32

# First administrator (created on first start if it does not exist yet)
QHC_ADMIN_EMAIL=admin@your-company.com
QHC_ADMIN_PASSWORD=change-me-min-12-chars

# Published HTTP port of the web container
QHC_HTTP_PORT=8080
# JSON list of browser origins allowed to call the API (only needed if the UI is served from another origin)
QHC_CORS_ORIGINS=["http://localhost:8080"]

# Parallel analysis jobs per worker container (each job can use several parser threads)
QHC_WORKER_CONCURRENCY=2
# Upload ceiling in bytes (default 100 GiB)
QHC_MAX_UPLOAD_BYTES=107374182400

# Optional: OpenAI-compatible endpoint to augment the AI Assistant. Leave empty for the built-in
# deterministic QRadar knowledge model (answers are always grounded in the uploaded assessment).
QHC_LLM_BASE_URL=
QHC_LLM_API_KEY=
QHC_LLM_MODEL=gpt-4o-mini
